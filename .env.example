DB_PORT=3307
DB_URL=jdbc:mysql://127.0.0.1:3307/vidi?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=vidi
DB_PASSWORD=

# JWT 서명 비밀키는 32바이트 이상이어야 한다. local은 주석 처리 시 개발용 기본값을 사용한다.
# JWT_SECRET=
# Access Token 유효 시간(Duration 형식, 기본 30m)
# JWT_ACCESS_TOKEN_EXPIRATION=30m
# CORS 허용 FE 주소(쉼표 구분). local 기본값은 http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
